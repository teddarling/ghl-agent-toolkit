# HighLevel Private Integration token (Settings > Private Integrations in your sub-account).
# Sent as a Bearer token on every API request. Keep it out of version control.
GHL_API_TOKEN=your-private-integration-token

# The GHL location (sub-account) ID this toolkit operates on.
GHL_LOCATION_ID=your-location-id

# Optional — override the HighLevel API base URL. Defaults to the production API;
# only set this for testing against a mock server.
# GHL_API_BASE_URL=https://services.leadconnectorhq.com

# Anthropic API key for the agent LLM layer. Only agent commands need it —
# doctor and the read commands work without it.
# GHL_ANTHROPIC_API_KEY=your-anthropic-api-key

# Model the agents call. claude-opus-5 (default) for best quality;
# claude-haiku-4-5 is the explicit cost-saving alternative.
# GHL_ANTHROPIC_MODEL=claude-opus-5

# Maximum tokens per model response.
# GHL_LLM_MAX_TOKENS=4096

# Per-run USD budget for agent LLM calls. The run hard-stops once spent.
# GHL_AGENT_BUDGET_USD=1.0

# Where the LLM trace log (one JSONL line per model call attempt) is written.
# GHL_LLM_TRACE_PATH=llm-trace.jsonl

# Contact custom field the lead_scorer writes to. By default the field is
# resolved read-only by key (fieldKey suffix "lead_score"); set the id to pin
# it explicitly. The toolkit never creates fields — create it in GHL first.
# GHL_SCORE_FIELD_KEY=lead_score
# GHL_SCORE_FIELD_ID=

# Where the audit log (one JSONL entry per applied write) is written.
# GHL_AUDIT_LOG_PATH=audit.log.jsonl

# Where the webhook server's proposal queue (JSONL) is stored.
# GHL_PROPOSALS_PATH=proposals.jsonl

# Demo mode: the server and `ghl agent tag` run the full propose → approve →
# apply loop against seeded fake data — no GHL account or API keys needed.
# GHL_DEMO_MODE=1

# Optional shared secret for webhook callers that cannot sign requests (e.g.
# workflow "custom webhook" actions). When set, POST /webhooks/ghl requires a
# matching X-Webhook-Secret header.
# GHL_WEBHOOK_SHARED_SECRET=choose-a-long-random-string

# Verify the X-GHL-Signature (Ed25519) header on webhooks against GHL's
# published public key. Off by default — see VERIFY.md (V9) for when it applies.
# GHL_WEBHOOK_VERIFY_SIGNATURE=1
